// ===================================================================
//                  CONFIGURACIÓN DE FASTFETCH (SIX)
// ===================================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ❯ "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "󰚌 Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󱎫 Uptime",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "󰏖 Pacotes",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "󰍛 Memoria",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}